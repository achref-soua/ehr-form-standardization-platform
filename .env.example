# Runtime profile: central keeps pseudonymized patient-level data; site exports aggregates only.
EHRFS_DEPLOYMENT_MODE=central
# Demo authentication must be disabled for any non-local deployment.
EHRFS_DEMO_MODE=true
# Compose migrates explicitly; host-only demos may opt into metadata creation.
EHRFS_AUTO_CREATE_SCHEMA=false
EHRFS_ENVIRONMENT=development
# Compose adds the host group to non-root containers so they can read local signing keys.
EHRFS_HOST_GID=1000
EHRFS_LOG_LEVEL=INFO
EHRFS_API_HOST=0.0.0.0
EHRFS_API_PORT=8000
EHRFS_WEB_ORIGIN=http://localhost:3000
EHRFS_DATABASE_URL=postgresql+psycopg://ehrfs_app:ehrfs_app_local_only@postgres:5432/ehrfs
EHRFS_DATABASE_SSLMODE=disable
EHRFS_S3_ENDPOINT=http://minio:9000
EHRFS_S3_REGION=eu-west-3
EHRFS_S3_ACCESS_KEY=ehrfs-local
EHRFS_S3_SECRET_KEY=ehrfs-local-secret
EHRFS_S3_USE_SSL=false
EHRFS_S3_RAW_BUCKET=ehrfs-raw
EHRFS_S3_CANONICAL_BUCKET=ehrfs-canonical
EHRFS_S3_DOCUMENT_BUCKET=ehrfs-documents
EHRFS_S3_MAPPING_BUCKET=ehrfs-mapping-releases
EHRFS_S3_RESEARCH_BUCKET=ehrfs-research-releases
# Generate with `make keys`; never commit the private key.
EHRFS_SIGNING_PRIVATE_KEY_PATH=/run/secrets/ehrfs_signing_key
EHRFS_SIGNING_PUBLIC_KEY_PATH=/run/secrets/ehrfs_signing_key.pub
# Generate a unique secret outside demo environments.
EHRFS_SESSION_SECRET=replace-with-at-least-32-random-characters
EHRFS_CSRF_SECRET=replace-with-at-least-32-random-characters
# Site-local pseudonymization key. It must never be centralized in a real deployment.
EHRFS_PSEUDONYMIZATION_KEY=replace-with-a-site-local-secret
EHRFS_JOB_LEASE_SECONDS=60
EHRFS_JOB_HEARTBEAT_SECONDS=15
EHRFS_PARTITION_ROWS=50000
EHRFS_UPLOAD_MAX_BYTES=26214400
EHRFS_SMALL_CELL_THRESHOLD=10
# Leave blank for core. `make up-full` enables the local collector automatically.
EHRFS_OTEL_EXPORTER_OTLP_ENDPOINT=
EHRFS_PROMETHEUS_MULTIPROC_DIR=/tmp/ehrfs-prometheus
EHRFS_OCR_ENDPOINT=http://ocr:8081
EHRFS_OCR_CONFIDENCE_THRESHOLD=0.85
EHRFS_CLAMAV_HOST=clamav
EHRFS_CLAMAV_PORT=3310
# auto uses ClamAV except for uploads explicitly marked as generated demo fixtures.
EHRFS_MALWARE_SCANNER=auto
